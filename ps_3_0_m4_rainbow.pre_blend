#define PC
#define IS_VERTEX_SHADER 0
#define IS_PIXEL_SHADER 1
#include <shader_vars.h>

#define PROJMAP_BLENDOFFSET 0.25
#define PROJMAP_BLENDEXPONENT 1.5
#define WORLDPOS_TO_PROJECTION_SCALE 32.0

struct PixelInput
{
    float4 position : POSITION;
    float3 worldPos : TEXCOORD1;
    float3 worldNormal : TEXCOORD2;
};

struct PixelOutput
{
    float4 color : COLOR;
};

PixelOutput ps_main(const PixelInput pixel)
{
    PixelOutput output;

    float phase = gameTime.w * 0.15;

    float3 rainbow;
    rainbow.r = 0.5 + 0.5 * cos(6.2831853 * phase);
    rainbow.g = 0.5 + 0.5 * cos(6.2831853 * (phase + 0.3333333));
    rainbow.b = 0.5 + 0.5 * cos(6.2831853 * (phase + 0.6666667));

    float2 uvFront = pixel.worldPos.yz * WORLDPOS_TO_PROJECTION_SCALE;
    float2 uvSide  = pixel.worldPos.xz * WORLDPOS_TO_PROJECTION_SCALE;
    float2 uvTop   = pixel.worldPos.xy * WORLDPOS_TO_PROJECTION_SCALE;

    float3 blend = abs(pixel.worldNormal);
    blend = saturate(blend - PROJMAP_BLENDOFFSET);
    blend = pow(blend, PROJMAP_BLENDEXPONENT);
    blend /= max(blend.x + blend.y + blend.z, 0.0001);

    float3 projectedRainbow = rainbow;

    float pattern = 0.5 + 0.5 * sin(
        (uvFront.x + uvSide.x + uvTop.x) * 0.15 + phase * 6.2831853
    );

    projectedRainbow *= 0.65 + pattern * 0.35;

    output.color.rgb = projectedRainbow;
    output.color.a = 1.0;

    return output;
}